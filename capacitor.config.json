{
  "appId": "top.folia.custom",
  "appName": "Folia 定制版",
  "webDir": "dist",
  "loggingBehavior": "none",
  "backgroundColor": "#141033",
  "android": {
    "allowMixedContent": true
  },
  "server": {
    "androidScheme": "https",
    "hostname": "localhost",
    "cleartext": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 220,
      "backgroundColor": "#141033",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "LIGHT",
      "backgroundColor": "#141033"
    }
  }
}
